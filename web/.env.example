# ==============================================================================
# TRUSTHIRE - ENVIRONMENT VARIABLES
# ==============================================================================
# ⚠️ This is an example file. 
# Copy this file to '.env' and fill in your actual values.
# NEVER commit your real '.env' file to Github!

# 1. Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2. Enoki / zkLogin Setup
# Get these from the Mysten Labs Enoki portal (https://enoki.mystenlabs.com)
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_API_KEY=

# Get this from your Google Cloud Console (APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 3. Smart Contract / Package IDs
# Testnet deployments
NEXT_PUBLIC_TESTNET_PACKAGE_ID=
NEXT_PUBLIC_TESTNET_REGISTRY_ID=
NEXT_PUBLIC_COIN_TYPE="0x2::sui::SUI"

# Mainnet deployments
NEXT_PUBLIC_MAINNET_PACKAGE_ID=

# 4. Gonka AI Router
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_MODELS=MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731

# 5. GitHub OAuth (Hono Server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3010/auth/github/callback
