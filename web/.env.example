# ==============================================================================
# TRUSTHIRE - ENVIRONMENT VARIABLES
# ==============================================================================
# ⚠️ This is an example file. 
# Copy this file to '.env' and fill in your actual values.
# NEVER commit your real '.env' file to Github!

# 1. Enoki / zkLogin Setup
# You get this from the Mysten Labs Enoki portal (https://enoki.mystenlabs.com)
NEXT_PUBLIC_ENOKI_API_KEY=

# You get this from your Google Cloud Console (APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 2. Smart Contract / Package IDs
# The Package ID when you publish your move code to the Testnet
NEXT_PUBLIC_TESTNET_PACKAGE_ID=

# The Package ID when you publish your move code to the Mainnet
NEXT_PUBLIC_MAINNET_PACKAGE_ID=
