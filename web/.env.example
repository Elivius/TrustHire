# ==============================================================================
# TRUSTHIRE - ENVIRONMENT VARIABLES
# ==============================================================================
# ⚠️ This is an example file. 
# Copy this file to '.env' and fill in your actual values.
# NEVER commit your real '.env' file to Github!

# 0. Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Server-side PostgreSQL tooling only. Percent-encode special characters in
# the password before putting it in this URL.
DATABASE_URL=postgresql://postgres.project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# 1. Enoki / zkLogin Setup
# You get this from the Mysten Labs Enoki portal (https://enoki.mystenlabs.com)
NEXT_PUBLIC_ENOKI_API_KEY=

# You get this from your Google Cloud Console (APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 2. Smart Contract / Package IDs
# The Package ID when you publish your move code to the Testnet
NEXT_PUBLIC_TESTNET_PACKAGE_ID=

# The Package ID when you publish your move code to the Mainnet
NEXT_PUBLIC_MAINNET_PACKAGE_ID=
